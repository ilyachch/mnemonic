    "description": "Create a project memory note for durable, reusable project knowledge discovered during work.\n\nUse for stable facts that will help future agents: decisions, architecture, conventions, setup steps, API contracts, debugging findings, constraints, or task outcomes.\n\nBefore creating, search existing notes to avoid duplicates. Prefer edit_note when a related note already exists. Do not store secrets, credentials, guesses, temporary chat details, or unverified assumptions.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "description": "Markdown body with verified durable knowledge, context, and useful links. Do not include secrets, guesses, or temporary chat details.",
          "type": "string"
        },
        "path": {
          "description": "Optional relative path under the project memory root.",
          "type": "string"
        },
        "tags": {
          "description": "Optional project memory tags. Prefer existing tag conventions.",
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
